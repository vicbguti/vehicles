# Los CSV del SRI (499 MB) van por Git LFS. El hook de .githooks/pre-commit
# --activo vía pre-commit, sin pasos manuales-- rechaza commitearlos como blobs:
# ya ocurrió una vez y por eso .git pesa lo que pesa.
data/clean/*.csv filter=lfs diff=lfs merge=lfs -text

# Binarios de modelo. Hoy son ~3,5 MB versionados como blobs normales, así que
# cada reentrenamiento infla .git para siempre. Esto no reescribe la historia:
# corrige de aquí en adelante.
artifacts/**/*.keras  filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.pt     filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.joblib filter=lfs diff=lfs merge=lfs -text
